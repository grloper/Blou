From 63b948ca5cb94307fd5444ee6e73927a41ccdab4 Mon Sep 17 00:00:00 2001
Subject: [PATCH 2/2] cmake/android: forward IN_LIST policy and quote NDK environment

Rebased on FreeRDP 3.31.1. Preserve cJSON policy minimum. No helper
files or OpenSSL source patches. Use the native host PATH separator;
ExternalProject LIST_SEPARATOR restores Windows semicolons.

diff --git a/client/Android/cmake/ExternalDeps.cmake b/client/Android/cmake/ExternalDeps.cmake
--- a/client/Android/cmake/ExternalDeps.cmake
+++ b/client/Android/cmake/ExternalDeps.cmake
@@ -29,6 +29,7 @@
     -DCMAKE_INSTALL_BINDIR:STRING=${CMAKE_INSTALL_BINDIR}
     -DCMAKE_INSTALL_DOCDIR:STRING=${CMAKE_INSTALL_DOCDIR}
     -DCMAKE_INSTALL_INCLUDEDIR:STRING=${CMAKE_INSTALL_INCLUDEDIR}
+    -DCMAKE_POLICY_DEFAULT_CMP0057:STRING=NEW
 )
 
 set(ANDROID_NATIVE_DEPS "")
diff --git a/client/Android/cmake/ExternalOpenSSL.cmake b/client/Android/cmake/ExternalOpenSSL.cmake
--- a/client/Android/cmake/ExternalOpenSSL.cmake
+++ b/client/Android/cmake/ExternalOpenSSL.cmake
@@ -16,7 +16,14 @@
   message(FATAL_ERROR "ExternalOpenSSL: unsupported ABI '${ANDROID_ABI}'")
 endif()
 
-set(NDK_TOOLCHAIN_BIN "${NDK_ROOT}/toolchains/llvm/prebuilt/${NDK_HOST_PLATFORM}/bin")
+file(TO_CMAKE_PATH "${NDK_ROOT}" NDK_ROOT_SLASH)
+set(NDK_TOOLCHAIN_BIN "${NDK_ROOT_SLASH}/toolchains/llvm/prebuilt/${NDK_HOST_PLATFORM}/bin")
+if(CMAKE_HOST_WIN32)
+  string(REPLACE ";" "|" OSSL_ENV_PATH "$ENV{PATH}")
+  set(OSSL_ENV_PATH "${NDK_TOOLCHAIN_BIN}|${OSSL_ENV_PATH}")
+else()
+  set(OSSL_ENV_PATH "${NDK_TOOLCHAIN_BIN}:$ENV{PATH}")
+endif()
 
 ExternalProject_Add(
   openssl
@@ -27,13 +34,13 @@
   URL_HASH ${OPENSSL_HASH}
   LIST_SEPARATOR |
   CONFIGURE_COMMAND
-    ${CMAKE_COMMAND} -E env PATH=${NDK_TOOLCHAIN_BIN}:$ENV{PATH} ANDROID_NDK=${NDK_ROOT} ANDROID_NDK_ROOT=${NDK_ROOT}
-    ANDROID_NDK_HOME=${NDK_ROOT} CC=clang perl <SOURCE_DIR>/Configure ${OSSL_ARCH} shared no-tests no-apps no-docs
+    ${CMAKE_COMMAND} -E env "PATH=${OSSL_ENV_PATH}" "ANDROID_NDK=${NDK_ROOT_SLASH}" "ANDROID_NDK_ROOT=${NDK_ROOT_SLASH}"
+    "ANDROID_NDK_HOME=${NDK_ROOT_SLASH}" perl <SOURCE_DIR>/Configure ${OSSL_ARCH} shared no-tests no-apps no-docs
     -U__ANDROID_API__ -D__ANDROID_API__=${NDK_API_LEVEL} --prefix=${DEPS_INSTALL_DIR} --libdir=${CMAKE_INSTALL_LIBDIR}
-  BUILD_COMMAND ${CMAKE_COMMAND} -E env PATH=${NDK_TOOLCHAIN_BIN}:$ENV{PATH} ANDROID_NDK=${NDK_ROOT}
-                ANDROID_NDK_ROOT=${NDK_ROOT} ANDROID_NDK_HOME=${NDK_ROOT} make -j SHLIB_EXT=.so build_libs
+  BUILD_COMMAND ${CMAKE_COMMAND} -E env "PATH=${OSSL_ENV_PATH}" "ANDROID_NDK=${NDK_ROOT_SLASH}"
+                "ANDROID_NDK_ROOT=${NDK_ROOT_SLASH}" "ANDROID_NDK_HOME=${NDK_ROOT_SLASH}" make -j SHLIB_EXT=.so build_libs
   INSTALL_COMMAND
-    ${CMAKE_COMMAND} -E env PATH=${NDK_TOOLCHAIN_BIN}:$ENV{PATH} ANDROID_NDK=${NDK_ROOT} ANDROID_NDK_ROOT=${NDK_ROOT}
-    ANDROID_NDK_HOME=${NDK_ROOT} make -j SHLIB_EXT=.so install_sw && ${CMAKE_COMMAND} -E copy_directory
+    ${CMAKE_COMMAND} -E env "PATH=${OSSL_ENV_PATH}" "ANDROID_NDK=${NDK_ROOT_SLASH}" "ANDROID_NDK_ROOT=${NDK_ROOT_SLASH}"
+    "ANDROID_NDK_HOME=${NDK_ROOT_SLASH}" make -j SHLIB_EXT=.so install_sw && ${CMAKE_COMMAND} -E copy_directory
     ${DEPS_INSTALL_DIR}/${CMAKE_INSTALL_LIBDIR}/ossl-modules ${DEPS_INSTALL_DIR}/${CMAKE_INSTALL_LIBDIR}
 )
